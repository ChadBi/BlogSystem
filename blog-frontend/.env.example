# Directus 后台地址（仅服务端可见，不要加 NEXT_PUBLIC_ 前缀以避免泄露内部 URL）。
# 未配置时，前台会自动使用 lib/mock-data.ts 中的模拟数据。
DIRECTUS_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=
# 站点公开访问地址（用于 metadataBase，可暴露到客户端）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 管理后台登录密码（前端独立鉴权，与 Directus admin 密码无关）
ADMIN_PASSWORD=changeme
# 鉴权签名密钥，用于 HMAC 签发 admin_session cookie
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# Directus admin 凭据（仅服务端可见，用于后台 CRUD API 调用 Directus 写入接口）
# 与 directus-cms/.env 的 ADMIN_EMAIL / ADMIN_PASSWORD 保持一致
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=changeme
